{%- if value -%}
    {%- import '@OroUI/macros.html.twig' as UI -%}
    {{ UI.entityViewLink(value, attribute(value, 'fullName'), 'oro_customer_customer_user_view', 'VIEW') }}

    {%- set impersonator = record.getValue('impersonator') -%}
    {%- if impersonator -%}
        <div class="text-muted">
            {{ 'oro.customer.customeruserloginattempt.impersonated_by'|trans }}
            {{ UI.entityViewLink(
                impersonator,
                attribute(impersonator, 'fullName'),
                'oro_user_view',
                'VIEW'
            ) }}
        </div>
    {%- endif -%}
{%- endif -%}
